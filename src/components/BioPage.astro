---
import { Image } from "astro:assets";

import { type Locale } from "../i18n/config";
import { useTranslations } from "../i18n/utils";

import Layout from "../layouts/Layout.astro";

import ProjectsModal from "../components/ProjectsModal.astro";
import BioContentEs from "../components/BioContentEs.astro";
import BioContentEn from "../components/BioContentEn.astro";

import biopic from "../assets/biopic.jpg";
import gonzalezAlmeida from "../assets/cartas/gonzalezAlmeida.jpg";
import sichero from "../assets/cartas/sichero.jpg";
import garciaPardo from "../assets/cartas/garciaPardo.jpg";
import viera from "../assets/cartas/viera.jpg";
import munozdelCampo from "../assets/cartas/munozdelCampo.jpg";
import ricardoSaxlund from "../assets/cartas/ricardoSaxlund.jpg";

const t = useTranslations(Astro.currentLocale as Locale);
---

<Layout>
  <div class="container">
    <div class="row">
      <div class="col-12"></div>
      <div
        class="col-12 col-md-6 col-xl-8 offset-md-3 offset-xl-2 biography js-biography"
      >
        <h1 class="display-2 text-center mb-4">
          {t("biography")}
        </h1>
        <div class="text-center">
          <Image src={biopic} class="img-fluid mb-4" alt={t("bio_pic_alt")} />
        </div>
        {Astro.currentLocale === "en" ? <BioContentEn /> : <BioContentEs />}
        <div
          class="modal fade js-modal js-letters-modal"
          id="letters-modal"
          tabindex="-1"
          aria-labelledby="letters-modal-title"
          aria-hidden="true"
        >
          <div class="modal-dialog modal-xl">
            <div class="modal-content">
              <div class="modal-header">
                <h4 class="modal-title" id="letters-modal-title">
                  {t("letters")}
                </h4>
                <button
                  type="button"
                  class="btn-close"
                  data-bs-dismiss="modal"
                  aria-label={t("close")}
                >
                </button>
              </div>
              <div class="modal-body">
                <div
                  id="letters-modal-carousel"
                  class="carousel carousel-dark slide js-letters-modal-carousel"
                  data-bs-interval="false"
                >
                  <div class="carousel-indicators">
                    <button
                      type="button"
                      data-bs-target="#letters-modal-carousel"
                      data-bs-slide-to="0"
                      class="active"
                      aria-current="true"
                      aria-label={`${t("letter_from")} Arq. Ramón González Almeida`}
                    >
                    </button>
                    <button
                      type="button"
                      data-bs-target="#letters-modal-carousel"
                      data-bs-slide-to="1"
                      aria-label={`${t("letter_from")} Arq. Raúl Sichero`}
                    >
                    </button>
                    <button
                      type="button"
                      data-bs-target="#letters-modal-carousel"
                      data-bs-slide-to="2"
                      aria-label={`${t("letter_from")} Arq. Luis García Pardo`}
                    >
                    </button>
                    <button
                      type="button"
                      data-bs-target="#letters-modal-carousel"
                      data-bs-slide-to="3"
                      aria-label={`${t("letter_from")} Leonel Viera`}
                    >
                    </button>
                    <button
                      type="button"
                      data-bs-target="#letters-modal-carousel"
                      data-bs-slide-to="4"
                      aria-label={`${t("letter_from")} Arq. Don Alberto Muñóz del Campo`}
                    >
                    </button>
                    <button
                      type="button"
                      data-bs-target="#letters-modal-carousel"
                      data-bs-slide-to="5"
                      aria-label={`${t("letter_from")} Arq. Ricardo Saxlund`}
                    >
                    </button>
                  </div>
                  <div class="carousel-inner">
                    <div class="carousel-item active mb-4">
                      <Image
                        src={gonzalezAlmeida}
                        class="d-block w-100"
                        alt={`${t("letter_from")} Arq. Ramón González Almeida`}
                      />
                      <h5 class="text-center mb-4">
                        Arq. Ramón González Almeida
                      </h5>
                    </div>
                    <div class="carousel-item mb-4">
                      <Image
                        src={sichero}
                        class="d-block w-100"
                        alt={`${t("letter_from")} Arq. Raúl Sichero`}
                      />
                      <h5 class="text-center mb-4">Arq. Raúl Sichero</h5>
                    </div>
                    <div class="carousel-item mb-4">
                      <Image
                        src={garciaPardo}
                        class="d-block w-100"
                        alt={`${t("letter_from")} Arq. Luis García Pardo`}
                      />
                      <h5 class="text-center mb-4">Arq. Luis García Pardo</h5>
                    </div>
                    <div class="carousel-item mb-4">
                      <Image
                        src={viera}
                        class="d-block w-100"
                        alt={`${t("letter_from")} Leonel Viera`}
                      />
                      <h5 class="text-center mb-4">Leonel Viera</h5>
                    </div>
                    <div class="carousel-item mb-4">
                      <Image
                        src={munozdelCampo}
                        class="d-block w-100"
                        alt={`${t("letter_from")} Arq. Don Alberto Muñóz del Campo`}
                      />
                      <h5 class="text-center mb-4">
                        Arq. Don Alberto Muñóz del Campo
                      </h5>
                    </div>
                    <div class="carousel-item mb-4">
                      <Image
                        src={ricardoSaxlund}
                        class="d-block w-100"
                        alt={`${t("letter_from")} Arq. Ricardo Saxlund`}
                      />
                      <h5 class="text-center mb-4">Arq. Ricardo Saxlund</h5>
                    </div>
                  </div>
                  <button
                    class="carousel-control-prev"
                    type="button"
                    data-bs-target="#letters-modal-carousel"
                    data-bs-slide="prev"
                  >
                    <span class="carousel-control-prev-icon" aria-hidden="true"
                    ></span>
                    <span class="visually-hidden">
                      {t("previous")}
                    </span>
                  </button>
                  <button
                    class="carousel-control-next"
                    type="button"
                    data-bs-target="#letters-modal-carousel"
                    data-bs-slide="next"
                  >
                    <span class="carousel-control-next-icon" aria-hidden="true"
                    ></span>
                    <span class="visually-hidden">
                      {t("next")}
                    </span>
                  </button>
                </div>
              </div>
              <div class="modal-footer">
                <button
                  type="button"
                  class="btn btn-primary js-modal-fullscreen"
                  data-modal="letters-modal"
                >
                  <span class="modal__fullscreen modal__fullscreen--enlarge">
                    {t("enlarge")}
                  </span>
                  <span class="modal__fullscreen modal__fullscreen--reduce">
                    {t("reduce")}
                  </span>
                </button>
                <button
                  type="button"
                  class="btn btn-secondary"
                  data-bs-dismiss="modal"
                >
                  {t("close")}
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <ProjectsModal />
  <script src="../scripts/bio.ts"></script>
  <script src="../scripts/projects.ts"></script>
</Layout>
