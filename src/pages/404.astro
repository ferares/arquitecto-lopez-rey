---
import Layout from "../layouts/Layout.astro";

import { type Locale } from "../i18n/config";
import { useTranslations } from "../i18n/utils";

const t = useTranslations(Astro.currentLocale as Locale);
---

<Layout>
  <div class="d-flex flex-column align-items-center justify-content-center text-center py-5" style="min-height: 60vh;">
    <h1 class="display-1 fw-bold text-secondary">404</h1>
    <h2 class="mb-3">{t("not_found")}</h2>
  </div>
</Layout>