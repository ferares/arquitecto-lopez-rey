---
import projects from "../../../data/projects.json";

import { locales, type Locale } from "../../../i18n/config";
import { useTranslations } from "../../../i18n/utils";

export const partial = true;

export function getStaticPaths() {
  return locales.flatMap((lang) =>
    projects.map((project) => ({
      params: { lang, prefix: project.prefix },
      props: { project },
    })),
  );
}

const { project } = Astro.props;

const photos: string[] = [];
for (let index = 1; index <= project.imgCount; index++) {
  const imageIndex = index.toString().padStart(2, "0");
  photos.push(`gallery/${project.prefix}_big_${imageIndex}.jpg`);
}

const t = useTranslations(Astro.currentLocale as Locale);
---

<div
  id="projects-modal-carousel"
  class="carousel carousel-dark slide"
  data-bs-interval="false"
>
  <div class="carousel-inner">
    <div class="carousel-item active">
      <img
        src={`/imgs/${photos[0]}`}
        class="d-block w-100"
        alt={`${project.name} foto 1`}
      />
    </div>
    {
      photos.slice(1).map((photo, index) => (
        <div class="carousel-item">
          <img
            src={`/imgs/${photo}`}
            class="d-block w-100"
            alt={`${project.name} foto ${index + 2}`}
          />
        </div>
      ))
    }
  </div>
  <div class="carousel-indicators position-static">
    {
      photos.length > 0 && (
        <>
          <button
            type="button"
            data-bs-target="#projects-modal-carousel"
            data-bs-slide-to="0"
            class="active"
            aria-current="true"
            aria-label={`${t("photo")} 1`}
          />
          {photos.slice(1).map((_, index) => (
            <button
              type="button"
              data-bs-target="#projects-modal-carousel"
              data-bs-slide-to={index + 1}
              aria-label={`${t("photo")} ${index + 2}`}
            />
          ))}
        </>
      )
    }
  </div>
  {photos.length > 0 && (
    <button
      class="carousel-control-prev"
      type="button"
      data-bs-target="#projects-modal-carousel"
      data-bs-slide="prev"
    >
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">
        {t("previous")}
      </span>
    </button>
    <button
      class="carousel-control-next"
      type="button"
      data-bs-target="#projects-modal-carousel"
      data-bs-slide="next"
    >
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">
        {t("next")}
      </span>
    </button>
  )}
</div>
